@app.route("/ai_assistant", methods=["GET", "POST"])
def ai_assistant():

    if "user_id" not in session:
        return redirect("/")

    question = ""
    answer = ""
    error = ""
    sources = []

    if request.method == "POST":
        question = request.form.get("question", "").strip()

        if not question:
            error = "Please enter a question."
        else:
            try:
                packaging_result = retrieve_packaging_answer(question)

                if packaging_result is not None:
                    sources = packaging_result.get("sources", [])
                    # Packaging dimensions and prices are deterministic structured data.
                    # Return the calculated result directly instead of sending it through Qwen.
                    answer = packaging_result.get("answer") or packaging_result["context"]
                else:
                    sources = retrieve_ai_information(question)
                    context = "\n\n".join(
                        f"SOURCE: {source['title']}\n{source['information'] or ''}"
                        for source in sources
                    )
                    answer = ask_qwen(question, context, sources)
            except Exception as exc:
                print("Qwen error:", exc)
                error = (
                    "Qwen could not be started. Make sure the required packages are installed "
                    "and that the Qwen model can be downloaded on this computer."
                )

    return render_template(
        "aiAssistant.html",
        question=question,
        answer=answer,
        error=error,
        sources=sources
    )


