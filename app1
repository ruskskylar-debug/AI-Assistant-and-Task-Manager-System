@app.route("/add_ai_information", methods=["POST"])
def add_ai_information():

    if "user_id" not in session:
        return redirect("/")

    if session["role"] != "manager":
        return redirect("/employee")

    title = request.form.get(
        "title",
        ""
    ).strip()

    manual_information = request.form.get(
        "information",
        ""
    ).strip()

    uploaded_file = request.files.get(
        "file"
    )

    filename = None
    file_type = None
    file_information = ""

    try:

        if uploaded_file and uploaded_file.filename:

            if allowed_file(
                uploaded_file.filename
            ):

                filename = uploaded_file.filename

                file_type = get_file_extension(
                    filename
                )

                file_information = read_uploaded_file(
                    uploaded_file,
                    file_type
                )

        # If there is no title, use the uploaded filename
        if not title:

            if filename:
                title = filename
            else:
                title = "Store Information"

        # Combine typed information and file information
        combined_information = ""

        if manual_information:

            combined_information += manual_information

        if file_information:

            if combined_information:
                combined_information += "\n\n"

            combined_information += file_information

        if not combined_information:

            combined_information = "No information was provided."

        created_at = datetime.now().strftime(
            "%Y-%m-%d %I:%M %p"
        )

        conn = get_db_connection()

        cursor = conn.execute(
            """
            INSERT INTO ai_information
            (
                title,
                filename,
                file_type,
                information,
                created_at
            )
            VALUES (?, ?, ?, ?, ?)
            """,
            (
                title,
                filename,
                file_type,
                combined_information,
                created_at
            )
        )

        information_id = cursor.lastrowid
        conn.commit()
        conn.close()

        if file_type == "xlsx":
            uploaded_file.stream.seek(0)
            save_packaging_items_from_xlsx(uploaded_file.stream, information_id)

    except Exception as error:
        print("AI information upload error:", error)

    return redirect("/ai_information")


