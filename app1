def load_qwen():
    global qwen_tokenizer, qwen_model

    if qwen_tokenizer is not None and qwen_model is not None:
        return qwen_tokenizer, qwen_model

    if AutoTokenizer is None or AutoModelForCausalLM is None:
        raise RuntimeError(
            "Qwen is not installed. Run: py -m pip install -r requirements.txt"
        )

    qwen_tokenizer = AutoTokenizer.from_pretrained(QWEN_MODEL_NAME)
    qwen_model = AutoModelForCausalLM.from_pretrained(QWEN_MODEL_NAME)
    qwen_model.eval()

    return qwen_tokenizer, qwen_model


def extract_dimensions(question):
    """Return three dimensions when a question contains a pattern such as 9 x 7 x 4."""
    match = re.search(
        r"(?<!\d)(\d+(?:\.\d+)?)\s*[x×]\s*(\d+(?:\.\d+)?)\s*[x×]\s*(\d+(?:\.\d+)?)(?!\d)",
        question.lower()
    )
    if not match:
        return None
    return tuple(float(value) for value in match.groups())


def box_fits(item_dimensions, box_dimensions):
    """Allow the item to be rotated; every item dimension must fit in a box dimension."""
    return any(
        all(item <= box + 1e-9 for item, box in zip(item_dimensions, orientation))
        for orientation in permutations(box_dimensions)
    )


def retrieve_packaging_answer(question):
    """Use structured packaging data for dimension/price questions instead of sending the full Excel text to Qwen."""
    item_dimensions = extract_dimensions(question)
    if not item_dimensions:
        return None

    conn = get_db_connection()
    rows = conn.execute(
        """
        SELECT id, description, product_number, width, depth, height, box_price
        FROM packaging_items
        WHERE width IS NOT NULL AND depth IS NOT NULL AND height IS NOT NULL
        """
    ).fetchall()
    conn.close()

    suitable = []
    for row in rows:
        box_dimensions = (float(row["width"]), float(row["depth"]), float(row["height"]))
        if box_fits(item_dimensions, box_dimensions):
            suitable.append({
                "id": row["id"],
                "description": row["description"] or "Box",
                "product_number": row["product_number"],
                "width": box_dimensions[0],
                "depth": box_dimensions[1],
                "height": box_dimensions[2],
                "box_price": row["box_price"],
                "volume": box_dimensions[0] * box_dimensions[1] * box_dimensions[2]
            })

    if not suitable:
        return {
            "type": "packaging",
            "item_dimensions": item_dimensions,
            "answer": "I could not find a box in the saved packaging information that can accommodate those dimensions.",
            "context": "No suitable box was found in the structured packaging data.",
            "sources": []
        }

    suitable.sort(key=lambda item: (item["volume"], item["box_price"] if item["box_price"] is not None else float("inf")))
    best = suitable[0]

    return {
        "type": "packaging",
        "item_dimensions": item_dimensions,
        "answer": (
            f"The smallest suitable box found for an item measuring "
            f"{item_dimensions[0]:g} x {item_dimensions[1]:g} x {item_dimensions[2]:g} "
            f"is {best["width"]:g} x {best["depth"]:g} x {best["height"]:g}"
            f" (Product #{best["product_number"]})"
            f", with a retail price of {"$%.2f" % best["box_price"] if best["box_price"] is not None else "not listed"}."
        ),
        "best": best,
        "context": (
            f"Item dimensions: {item_dimensions[0]:g} x {item_dimensions[1]:g} x {item_dimensions[2]:g}.\n"
            f"Smallest suitable box found: {best['description']} ({best['width']:g} x {best['depth']:g} x {best['height']:g}).\n"
            f"Product number: {best['product_number'] or 'Not listed'}.\n"
            f"Box retail price: {('$%.2f' % best['box_price']) if best['box_price'] is not None else 'Not listed'}."
        ),
        "sources": [{"title": "Packaging Matrix", "filename": "Uploaded Excel packaging data"}]
    }


def retrieve_ai_information(question, limit=5):
    """Find the most relevant saved store-information chunks before Qwen answers."""
    conn = get_db_connection()
    rows = conn.execute(
        "SELECT id, title, filename, information FROM ai_information ORDER BY created_at DESC"
    ).fetchall()
    conn.close()

    question_words = set(
        word.lower()
        for word in re.findall(r"[A-Za-z0-9]+", question)
        if len(word) > 2
    )

    scored = []

    for row in rows:
        full_text = row["information"] or ""
        chunks = [full_text[i:i + 1200] for i in range(0, len(full_text), 1200)] or [""]

        for chunk_number, chunk in enumerate(chunks, start=1):
            searchable = f"{row['title']} {row['filename'] or ''} {chunk}"
            text_words = set(
                word.lower()
                for word in re.findall(r"[A-Za-z0-9]+", searchable)
                if len(word) > 2
            )
            score = len(question_words & text_words)

            if question.lower() in searchable.lower():
                score += 10

            if score > 0:
                scored.append({
                    "id": row["id"],
                    "title": row["title"],
                    "filename": row["filename"],
                    "information": chunk,
                    "chunk_number": chunk_number,
                    "score": score
                })

    scored.sort(key=lambda item: item["score"], reverse=True)
    return scored[:limit]


def ask_qwen(question, context, sources=None):
    tokenizer, model = load_qwen()

    if not context:
        return "I could not find information about that in the store's saved information. Please check with the manager."

    system_prompt = (
        "You are the UPS Store employee information assistant. "
        "Use only the store information provided. Do not invent prices, dimensions, policies, or procedures. "
        "For packaging questions, trust the calculated result supplied by the application rather than doing your own box comparison. "
        "Do not call a box the smallest unless the application has identified it as the smallest suitable box. "
        "Keep the answer concise and practical for a store employee."
    )

    messages = [
        {"role": "system", "content": system_prompt},
        {
            "role": "user",
            "content": f"STORE INFORMATION:\n{context}\n\nEMPLOYEE QUESTION:\n{question}"
        }
    ]

    prompt = tokenizer.apply_chat_template(
        messages,
        tokenize=False,
        add_generation_prompt=True
    )

    inputs = tokenizer(
        prompt,
        return_tensors="pt",
        truncation=True,
        max_length=1800
    )

    if hasattr(model, "device"):
        inputs = {key: value.to(model.device) for key, value in inputs.items()}

    with __import__("torch").no_grad():
        outputs = model.generate(
            **inputs,
            max_new_tokens=100,
            do_sample=False,
            pad_token_id=tokenizer.eos_token_id
        )

    generated = outputs[0][inputs["input_ids"].shape[1]:]
    answer = tokenizer.decode(generated, skip_special_tokens=True).strip()

    return answer or "I could not generate an answer. Please check with the manager."


def save_packaging_items_from_xlsx(file, information_id):
    """Extract structured box data by locating the packaging table headers."""
    workbook = load_workbook(file, data_only=True)
    items = []

    for sheet in workbook.worksheets:
        header_row = None
        width_col = depth_col = height_col = product_col = box_col = description_col = None

        # Find the row containing the actual packaging headers instead of assuming
        # the spreadsheet always starts at a particular row.
        for row_number in range(1, sheet.max_row + 1):
            values = [sheet.cell(row_number, column).value for column in range(1, sheet.max_column + 1)]
            normalized = {
                str(value).strip().upper(): index + 1
                for index, value in enumerate(values)
                if value is not None
            }

            if all(key in normalized for key in ("W", "D", "H", "PRODUCT #", "BOX")):
                header_row = row_number
                width_col = normalized["W"]
                depth_col = normalized["D"]
                height_col = normalized["H"]
                product_col = normalized["PRODUCT #"]
                box_col = normalized["BOX"]
                description_col = 2  # Column B contains the descriptive packaging name.
                break

        if header_row is None:
            continue

        for row_number in range(header_row + 1, sheet.max_row + 1):
            width = sheet.cell(row_number, width_col).value
            depth = sheet.cell(row_number, depth_col).value
            height = sheet.cell(row_number, height_col).value
            box_price = sheet.cell(row_number, box_col).value
            product_number = sheet.cell(row_number, product_col).value
            description = sheet.cell(row_number, description_col).value

            if not all(isinstance(value, (int, float)) for value in (width, depth, height)):
                continue

            if not isinstance(box_price, (int, float)):
                continue

            # Skip non-box notes/rows without a product number when possible.
            if product_number is None and description is None:
                continue

            items.append((
                str(description).strip() if description is not None else "Box",
                str(product_number).strip() if product_number is not None else None,
                float(width), float(depth), float(height), float(box_price), information_id
            ))

    conn = get_db_connection()
    conn.execute("DELETE FROM packaging_items WHERE source_information_id = ?", (information_id,))
    conn.executemany(
        """
        INSERT INTO packaging_items
        (description, product_number, width, depth, height, box_price, source_information_id)
        VALUES (?, ?, ?, ?, ?, ?, ?)
        """,
        items
    )
    conn.commit()
    conn.close()
    return len(items)


