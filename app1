@app.route("/employee")
def employee():

    if "user_id" not in session:
        return redirect("/")

    if session["role"] != "employee":
        return redirect("/manager")

    conn = get_db_connection()

    clean_old_tasks(conn)

    today = date.today().isoformat()

    todays_tasks = conn.execute(
        """
        SELECT *
        FROM tasks
        WHERE employee_id = ?
        AND task_date = ?
        ORDER BY id
        """,
        (
            session["user_id"],
            today
        )
    ).fetchall()

    week_start, week_end, week_days = get_week_dates(
        date.today()
    )

    weekly_tasks = conn.execute(
        """
        SELECT *
        FROM tasks
        WHERE employee_id = ?
        AND task_date BETWEEN ? AND ?
        ORDER BY task_date, id
        """,
        (
            session["user_id"],
            week_start.isoformat(),
            week_end.isoformat()
        )
    ).fetchall()

    unread_messages = conn.execute(
        """
        SELECT COUNT(*)
        FROM messages
        WHERE recipient_id = ?
        AND is_read = 0
        """,
        (session["user_id"],)
    ).fetchone()[0]

    conn.commit()
    conn.close()

    return render_template(
        "employee.html",
        username=session["username"],
        todays_tasks=todays_tasks,
        weekly_tasks=weekly_tasks,
        unread_messages=unread_messages
    )


