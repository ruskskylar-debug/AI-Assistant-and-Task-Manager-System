    conn = get_db_connection()

    user = conn.execute(
        """
        SELECT *
        FROM users
        WHERE id = ?
        """,
        (session["user_id"],)
    ).fetchone()

    if not user:

        conn.close()
        return redirect("/manager_account")

    if not check_password_hash(
        user["password"],
        current_password
    ):

        conn.close()
        return redirect("/manager_account")

    # Make sure username isn't already being used
    existing_user = conn.execute(
        """
        SELECT *
        FROM users
        WHERE username = ?
        AND id != ?
        """,
        (
            new_username,
            session["user_id"]
        )
    ).fetchone()

    if existing_user:

        conn.close()
        return redirect("/manager_account")

    # Change password if one was entered
    if new_password:

        if new_password != confirm_password:

            conn.close()
            return redirect("/manager_account")

        password = generate_password_hash(
            new_password
        )

    else:

        password = user["password"]

    conn.execute(
        """
        UPDATE users
        SET username = ?,
            password = ?
        WHERE id = ?
        """,
        (
            new_username,
            password,
            session["user_id"]
        )
    )

    conn.commit()
    conn.close()

    session["username"] = new_username

    return redirect("/manager_account")


