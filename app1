        )
    ).fetchall()

    for task in tasks:

        task_date = datetime.strptime(
            task["task_date"],
            "%Y-%m-%d"
        ).date()

        for day in week_days:

            if day["date"] == task_date:
                day["tasks"].append(task)

    employees = conn.execute(
        """
        SELECT *
        FROM users
        WHERE role = 'employee'
        ORDER BY username
        """
    ).fetchall()

    previous_week = (
        week_start - timedelta(days=7)
    ).isoformat()

    next_week = (
        week_start + timedelta(days=7)
    ).isoformat()

    is_current_week = (
        week_start <= date.today() <= week_end
    )

    conn.commit()
    conn.close()

    return render_template(
        "manageTasks.html",
        week_start=week_start,
        week_end=week_end,
        week_days=week_days,
        previous_week=previous_week,
        next_week=next_week,
        is_current_week=is_current_week,
        employees=employees
    )


